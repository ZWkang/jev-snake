{
	"name": "poker-game",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --parallel dev:server dev:web",
		"generate-routes": "tsr generate",
		"build": "bun run build:server && vite build",
		"start": "bun .output/server/index.mjs",
		"preview": "vite preview",
		"serve": "bun run --parallel start:server preview",
		"format": "oxfmt --write src server shared scripts tests .vscode package.json tsconfig.json tsr.config.json ui.config.json vercel.json vite.config.ts vitest.config.ts .oxfmtrc.json .oxlintrc.json",
		"format:check": "oxfmt --check src server shared scripts tests .vscode package.json tsconfig.json tsr.config.json ui.config.json vercel.json vite.config.ts vitest.config.ts .oxfmtrc.json .oxlintrc.json",
		"lint": "oxlint src server shared scripts tests vite.config.ts vitest.config.ts",
		"check": "bun run format:check && bun run lint",
		"dev:web": "vite dev --port 3000",
		"dev:server": "bun --watch server/index.ts",
		"build:server": "tsc -p server/tsconfig.json",
		"start:server": "bun --env-file=.env .server-build/server/index.js",
		"test": "vitest run",
		"test:snake": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
		"jev": "bun scripts/run-jev.ts"
	},
	"dependencies": {
		"@fontsource/inter": "^5.1.1",
		"@hono/node-server": "^2.1.1",
		"@kobalte/core": "^0.13.14",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/solid-query": "latest",
		"@tanstack/solid-query-devtools": "latest",
		"@tanstack/solid-router": "latest",
		"@tanstack/solid-router-devtools": "latest",
		"@tanstack/solid-start": "latest",
		"@tanstack/solid-store": "latest",
		"@tanstack/store": "latest",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.1",
		"hono": "^4.13.8",
		"nitro": "3.0.260610-beta",
		"solid-js": "^1.9.12",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7",
		"ws": "^8.21.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.133.21",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.2",
		"@types/ws": "^8.18.1",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0",
		"vite-plugin-solid": "^2.11.12",
		"vitest": "^5.0.1"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2"
}
