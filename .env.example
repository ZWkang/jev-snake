# Generate a private administrator key: openssl rand -hex 32
GAME_ADMIN_TOKEN=
SQLITE_PATH=.data/snake.sqlite
GAME_PORT=3001
GAME_HOST=127.0.0.1
# Continuous watch starts disabled; unlock /watch?admin=1 with GAME_ADMIN_TOKEN.
# Viewing pages never starts a match. Zero intermission starts the next round immediately.
WATCH_INTERMISSION_MS=5000
# Exact frontend origin (no trailing slash). Set HTTPS origin for deployed Secure cookies.
WATCH_PUBLIC_ORIGIN=http://localhost:3000
# Owner session lifetime; expiry/logout hides controls but does not stop an enabled channel.
WATCH_SESSION_TTL_MS=28800000
# Enable both the router panel and its Vite tooling explicitly. Default off.
VITE_ROUTER_DEVTOOLS=false
# Server-side only. Never use a VITE_ prefix for this key.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Optional: explicitly select openrouter to use this separate key.
OPENROUTER_API_KEY=
# Only response-driven, single-step decisions are supported.
SNAKE_STEP_MODE=response
# SNAKE_TICK_MS is retired. Existing values only produce a deprecation notice.
# Unset dimensions choose a seeded random size from 8x6 through 24x18.
# Default obstacles: floor(width * height / 36). Uncomment to fix them.
# SNAKE_WIDTH=24
# SNAKE_HEIGHT=18
# SNAKE_OBSTACLES=12
# Optional reproducible map; omitted means a new random seed.
# SNAKE_SEED=
